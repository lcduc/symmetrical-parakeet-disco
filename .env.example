POSTGRES_DSN=postgresql+asyncpg://hr_cv_matcher:hr_cv_matcher@localhost:5434/hr_cv_matcher
POSTGRES_DB=hr_cv_matcher
POSTGRES_USER=hr_cv_matcher
POSTGRES_PASSWORD=hr_cv_matcher

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VLM_DEVICE=cpu

# auto = native PDF text -> local fast OCR -> escalate to OCR_VLM_BACKEND on low
# quality (default). cloud_only = skip native text/local OCR entirely and always
# call OCR_VLM_BACKEND directly (pair with OCR_VLM_BACKEND=datalab for a fully
# cloud-based pipeline with no local OCR/VLM model capacity needed).
OCR_MODE=auto
# Min fast-OCR quality_score (0-1) before escalating to the VLM tier in auto mode.
OCR_QUALITY_THRESHOLD=0.85
OCR_VLM_BACKEND=paddle_vlm

DATALAB_API_KEY=
COMPANY_NAME=

API_KEY=
APP_API_KEY=

MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_PER_MINUTE=20

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

POSTGRES_PORT=5434
API_PORT=8002
STREAMLIT_PORT=8501

CORS_ALLOWED_ORIGINS=
FORWARDED_ALLOW_IPS=127.0.0.1
